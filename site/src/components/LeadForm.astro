---
// Одна форма заявки на весь сайт (SEO-MIGRATION.md, раздел 10): видимые подписи, отдельная галочка согласия на /consent
// (152-ФЗ, с 01.09.2025 согласие оформляется отдельно), город с онлайном, удобное время. Отправку и проверку ведёт common.js.
interface Props {
  id: string;                         // префикс id полей: несколько форм на странице
  interest?: 'select' | string;       // 'select' — выбор «Что интересно»; строка — скрытое значение
  submit?: string;
  note?: string;
}
const { id, interest = 'select', submit = 'Записаться', note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const INTERESTS = [
  ['visit', 'Частный визит в студию'],
  ['trial', 'Пробное занятие · 900 ₽'],
  ['buy', 'Подбор и покупка инструмента'],
  ['rent', 'Аренда инструмента'],
  ['help', 'Помочь определиться']
];
const CITIES = [['msk', 'Москва'], ['spb', 'Санкт-Петербург'], ['online', 'Онлайн']];
---
<form class="form" data-form novalidate>
  <slot />
  {interest === 'select'
    ? <div class="fld">
        <label class="fl" for={`${id}-interest`}>Что интересно</label>
        <select id={`${id}-interest`} name="interest" data-interest>
          {INTERESTS.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </div>
    : <input type="hidden" name="interest" value={interest}>}
  <fieldset class="fs fld">
    <legend class="fl">Город</legend>
    <div class="btns">
      {CITIES.map(([v, l], i) => <label class="chip-r"><input type="radio" name="city" value={v} checked={i === 0}><span>{l}</span></label>)}
    </div>
  </fieldset>
  <div class="fld">
    <label class="fl" for={`${id}-name`}>Имя</label>
    <input id={`${id}-name`} name="name" autocomplete="given-name" required>
  </div>
  <div class="fld">
    <label class="fl" for={`${id}-phone`}>Телефон</label>
    <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel" required aria-describedby={`${id}-phone-err`}>
    <div class="err" id={`${id}-phone-err`} aria-live="polite"></div>
  </div>
  <div class="fld">
    <label class="fl" for={`${id}-time`}>Удобное время <span class="fl-opt">— необязательно</span></label>
    <input id={`${id}-time`} name="time" placeholder="Например, будни после 18:00">
  </div>
  <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label class="consent"><input type="checkbox" name="consent" required><span>Даю <a href={u('consent')} target="_blank">согласие на обработку персональных данных</a></span></label>
  <p class="form-legal">Отправляя заявку, вы принимаете <a href={u('politikaconfidencialnosti')} target="_blank">политику конфиденциальности</a></p>
  <button type="submit" class="btn btn--blue btn--submit">{submit}</button>
  <div class="form-status" aria-live="polite"></div>
  {note && <span class="small">{note}</span>}
</form>
