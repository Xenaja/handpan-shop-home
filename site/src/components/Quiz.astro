---
// Тест «С чего начать?» — упрощённый, до 3 вопросов (правка 21.11): направление → формат занятий (только для знакомства
// и обучения) → что останавливает. Вопросы и исходы — в HTML; quiz.js переключает шаги, выбирает исход,
// кладёт ответы в заявку и шлёт цели в Метрику.
import Q from '../data/quiz.json';
const { id = 'quiz' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
type Res = { kicker: string; kickerTry?: string; text: string; step: string; meta: string; cta: string; open: string;
  after?: string; link?: string; href?: string; next?: string; lesson?: boolean };
const R = Q.results as Record<string, Res>;
const doubts = Object.fromEntries(Object.entries(R).map(([k, r]) => [k, {
  start: Q.doubts.start.replace('{next}', r.next || 'что дальше'),
  quit: Q.doubts.quit,
  choose: r.lesson ? Q.doubts.chooseLesson : Q.doubts.choose
}]));
---
<div class="quiz" data-quiz id={id} data-doubts={JSON.stringify(doubts)}>
  <div class="quiz-top">
    <div class="quiz-prog" aria-hidden="true"><i data-quiz-bar></i></div>
    <span class="mono quiz-count" data-quiz-count aria-live="polite">01 / {String(Q.questions.length).padStart(2, '0')}</span>
  </div>
  {Q.questions.map((s, i) => (
    <fieldset class="quiz-step" data-quiz-step={i} data-key={s.key} data-if={s.if ? s.if.join(' ') : undefined} hidden={i > 0}>
      <legend class="quiz-q">{s.q}</legend>
      <div class="quiz-opts">
        {s.a.map(a => (
          <label class="quiz-opt">
            <input type="radio" name={`${id}-q${i}`} value={a.v}>
            <span>{a.t}</span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}
  {Object.entries(R).map(([key, r]) => (
    <div class="quiz-res" data-quiz-res={key} hidden tabindex="-1">
      <h2 class="quiz-kicker" data-kicker={r.kicker} data-kicker-try={r.kickerTry}>{r.kicker}</h2>
      <p class="quiz-text">{r.text}</p>
      <p class="quiz-lead" data-quiz-lead hidden></p>
      <div class="quiz-step-card">
        <span class="mono">Ваш первый шаг</span>
        <span class="quiz-step-name">{r.step}</span>
        <span class="quiz-step-meta">{r.meta}</span>
      </div>
      <button type="button" class="btn btn--blue quiz-cta" data-open={r.open} data-quiz-cta>{r.cta} →</button>
      {r.after && <p class="small quiz-after">{r.after}</p>}
      {r.link && <a class="lnk quiz-link" href={`${base}/${r.href}`}>{r.link} →</a>}
    </div>
  ))}
  <div class="quiz-nav">
    <button type="button" class="btn btn--44 btn--line quiz-back" data-quiz-back hidden>← Назад</button>
    <button type="button" class="btn btn--44 btn--line quiz-again" data-quiz-again hidden>Пройти заново</button>
  </div>
</div>
