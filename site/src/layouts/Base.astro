---
// Общий каркас страницы: <head> по шаблону SEO-MIGRATION.md (раздел 4), служебные варианты для заказчика, скрипты.
interface Props {
  title: string;
  description: string;
  path: string;            // адрес страницы на боевом сайте, для canonical и og:url
  ogTitle?: string;
  ogDescription?: string;
  ogImage: string;         // путь от корня сайта: img/…
  theme?: string;
  styles: string[];
  scripts: string[];
  jsonld?: object;
  robots?: string;         // служебные и юридические страницы: 'noindex, follow'
  canonical?: boolean;     // false — без canonical (страница 404)
}
const { title, description, path, ogTitle = title, ogDescription = description, ogImage, theme = '#E8EEF4', styles, scripts, jsonld, robots, canonical: withCanonical = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const canonical = new URL(path, Astro.site).href;
const preview = base !== '';   // превью на GitHub Pages собирается с префиксом адресов, боевой сайт — от корня
const V = '29b';   // версия ресурсов: браузер не держит старые CSS/JS после выкладки
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{/* превью закрыто от индекса целиком (SEO-MIGRATION.md, п. 1.8); на боевом — только служебные страницы */}
{preview ? <meta name="robots" content="noindex"> : robots && <meta name="robots" content={robots}>}
<title>{title}</title>
<meta name="description" content={description}>
{withCanonical && <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="U-GENE sound vibe">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(ogImage, Astro.site).href}>
<meta name="theme-color" content={theme}>
<link rel="icon" type="image/png" href={u('img/favicon.png')}>
<link rel="apple-touch-icon" href={u('img/apple-touch-icon.png')}>
<!-- шрифты со своего сервера; основные начертания — заранее -->
<link rel="preload" as="font" type="font/woff2" href={u('fonts/unbounded-400-cyrillic.woff2')} crossorigin>
<link rel="preload" as="font" type="font/woff2" href={u('fonts/golos-text-400-cyrillic.woff2')} crossorigin>
<link rel="stylesheet" href={`${u('fonts.css')}?v=${V}`}>
<slot name="head" />
{styles.map(s => <link rel="stylesheet" href={`${u(s)}?v=${V}`}>)}
<script is:inline>
  // ?dev — пунктиром показать места, где ждём данные (PENDING.md); служебные варианты для заказчика:
  // ?hang=bronze | dark — купол на схеме ханга (выбор помним между страницами)
  (() => { const q = new URLSearchParams(location.search), h = document.documentElement;
    if (q.has('dev')) h.dataset.env = 'dev';
    const V = { hang: ['bronze', 'dark'] };
    for (const k in V) {
      let v = q.get(k);
      try { if (v === null) v = sessionStorage.getItem('hs-' + k); else sessionStorage.setItem('hs-' + k, v); } catch (e) {}
      if (V[k].includes(v)) h.dataset[k] = v;
    } })();
</script>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<script is:inline>
  // Яндекс Метрика — тот же счётчик 90206720, что на Тильде (SEO-MIGRATION.md, п. 1.9). Только на боевом домене,
  // чтобы превью не портило статистику. Вебвизор выключен: включать или нет — решает заказчик.
  if (location.hostname === 'handpanshop.pro') {
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
    ym(90206720, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
  }
</script>
</head>
<body>
<a class="skip" href="#main">К содержанию</a>
<slot />
{scripts.map(s => <script is:inline src={`${u(s)}?v=${V}`}></script>)}
</body>
</html>
