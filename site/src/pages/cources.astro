---
// «Обучение». Адрес /cources — как на Тильде, с опечаткой: он проиндексирован (SEO-MIGRATION.md, п. 1.11).
// Навыки, ступени, путь, форматы, преподаватели и FAQ собираются в HTML при сборке; learn.js их только переключает.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import BrandLines from '../components/BrandLines.astro';
import LeadForm from '../components/LeadForm.astro';
import BranchContacts from '../components/BranchContacts.astro';
import D from '../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const home = `${base}/`;
const initials = (s: string) => s.split(/\s+/).map(w => w[0]).join('').slice(0, 2);
const pad = (n: number) => String(n).padStart(2, '0');
// hidden — преподаватель временно не показывается (Андрей Лето — добавим позже)
const T = D.teachers.filter(t => !t.hidden);
const priceNum = (p: string) => p.replace(/\D/g, '');
const NEEDS = [
  { label: 'Инструмент', big: 'Не обязателен', text: 'На занятиях предоставляем хэндпан' },
  { label: 'Опыт', big: 'Не нужен', text: 'Большинство учеников начинали с нуля' },
  { label: 'Возраст', big: 'От 12 лет', text: 'Для детей младше – индивидуально' },
  { label: 'Что взять', big: 'Желание', text: 'Попробовать новое. Остальное есть в студии' }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Course', name: 'Обучение игре на ханге (хэндпане) с нуля',
      description: 'Групповые, индивидуальные и онлайн-занятия. Пробный урок 45 минут — 900 ₽, инструмент предоставляем.',
      inLanguage: 'ru',
      provider: { '@type': 'Organization', '@id': 'https://handpanshop.pro/#org', name: 'U-GENE sound vibe', url: 'https://handpanshop.pro/' },
      offers: [
        { '@type': 'Offer', name: 'Пробное занятие, 45 минут', price: '900', priceCurrency: 'RUB', category: 'Paid' },
        ...D.formats.map(f => ({ '@type': 'Offer', name: `${f.name} ${f.unit}`.replace(' / ', ', '), price: priceNum(f.price), priceCurrency: 'RUB', category: 'Paid' }))
      ] },
    { '@type': 'FAQPage', mainEntity: D.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://handpanshop.pro/' },
      { '@type': 'ListItem', position: 2, name: 'Обучение' } ] }
  ]
};
---
<Base
  title="Обучение игре на ханге с нуля — пробный урок 900 ₽ · U-GENE sound vibe"
  description="Научитесь играть на ханге с нуля. Пробное занятие 45 минут — 900 ₽, инструмент даём, опыт не нужен. Группы, индивидуально, онлайн. Москва и Санкт-Петербург."
  ogTitle="Обучение игре на ханге с нуля — U-GENE sound vibe"
  ogDescription="Пробное занятие 45 минут — 900 ₽. Инструмент даём, опыт не нужен."
  path="/cources" ogImage="img/edu-hero-d.webp" theme="#0A1020"
  styles={['common.css', 'learn.css', 'mobile.css']} scripts={['common.js', 'learn.js']} jsonld={jsonld}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={u('img/edu-hero-m.webp')} media="(max-width:999.98px)" fetchpriority="high">
    <link rel="preload" as="image" href={u('img/edu-hero-d.webp')} media="(min-width:1000px)" fetchpriority="high">
  </Fragment>

<!-- 01 · Научись играть на ханге -->
<header class="e1 on-dark" id="top">
  <picture>
    <source media="(min-width:1000px)" srcset={u('img/edu-hero-d.webp')} width="1617" height="973">
    <img class="e1-bg" src={u('img/edu-hero-m.webp')} alt="Музыкант играет на ханге" width="1200" height="722" fetchpriority="high">
  </picture>
  <div class="e1-shade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="hdr">
    <Logo class="pill glass-d logo" href={home} />
    <nav class="pill glass-d nav nav--edu hdr-d" aria-label="Основное меню">
      <a class="lnk" href={`${home}#making`}>Инструменты</a><span class="nav-on" aria-current="page">Обучение</span><a class="lnk" href="#contacts">Контакты</a>
    </nav>
    <div class="pill glass-d city e1-city hdr-d" role="group" aria-label="Город">
      <button type="button" data-city="msk" aria-pressed="true">Москва</button><button type="button" data-city="spb" aria-pressed="false">Санкт-Петербург</button>
    </div>
    <div class="hdr-n"><span class="burger-slot" aria-hidden="true"></span></div>
  </div>

  <div class="e1-body">
    <div class="stack e1-top">
      <h1 class="h-hero e1-h1">
        <span>Научись играть</span>
        <span class="cap cap--hero e1-cap">на ханге</span>
      </h1>
      <div class="stack e1-text">
        <p class="e1-lead">С нуля до первой мелодии — или от базовых навыков к сложным техникам.</p>
        <p class="e1-copy">За 45 минут познакомишься с инструментом, освоишь основы звукоизвлечения и сыграешь свою первую мелодию.</p>
        <p class="e1-copy">Без музыкального образования, собственного инструмента и предварительной подготовки.</p>
        <div class="btns e1-btns">
          <button type="button" class="btn btn--52 btn--blue" data-open="trial">Записаться на пробное · 900 ₽</button>
          <a class="btn btn--52 btn--line-d" href="#formats">Форматы и цены</a>
        </div>
      </div>
    </div>
    <div class="e1-bottom">
      <button type="button" class="e1-play" data-play aria-label="Послушать, как звучит ханг">
        <span class="play glass-d" data-play-ic aria-hidden="true"></span>
        <span class="stack e1-pmeta">
          <span data-play-label data-off="Послушать ханг" data-on="Играет D Kurd">Послушать ханг</span>
          <span class="wave" data-wave="18" aria-hidden="true"></span>
        </span>
      </button>
      <a class="e1-team hdr-d" href="#teachers">
        <span class="e1-ava" aria-hidden="true">
          {T.slice(0, 2).map(t => <span>{t.img ? <img src={u(t.face || t.img)} alt="" width="60" height="60"> : initials(t.name)}</span>)}<span class="glass-d">+{T.length - 2}</span>
        </span>
        <span class="e1-team-t">{T.length} преподавателей</span>
      </a>
    </div>
  </div>
</header>

<nav class="menu menu--sand" id="menu" hidden aria-label="Меню">
  <div class="menu-top">
    <Logo style="padding:0" href={home} />
    <button type="button" class="x" data-menu-close aria-label="Закрыть меню">×</button>
  </div>
  <div class="menu-links">
    <a href={`${home}#making`}>Инструменты</a><span class="menu-on" aria-current="page">Обучение</span><a href="#" data-pending="P-12">Блог</a><a href="#contacts">Контакты</a>
  </div>
  <div class="btns" role="group" aria-label="Город">
    <button type="button" class="chip" data-city="msk" aria-pressed="true">Москва</button><button type="button" class="chip" data-city="spb" aria-pressed="false">Санкт-Петербург</button>
  </div>
</nav>
<button type="button" class="burger" aria-expanded="false" aria-controls="menu" aria-label="Меню"><span></span><span></span></button>

<main id="main">

<!-- 02 · Разные подходы: 1–3 метка и фото · 4–12 цитата и ряд из трёх -->
<section class="sec e2" aria-label="Разные подходы">
  <div class="stack e2-l">
    <span class="mono">02 · Разные подходы</span>
    <div class="e-photo e2-photo"><img src={u('img/edu-46-m.webp')} alt="Ученица играет на ханге на отчётном концерте школы" width="1200" height="1800" loading="lazy"></div>
  </div>
  <div class="stack e2-r">
    <p class="e2-q">Мастера играют на ханге по-разному: для <b>Manu Delago</b> он звучит как арфа или перкуссия, для <b>Liron Meyuhas</b> – как инструмент сердца, тела и духа, <span class="mute">а создатели PANArt советуют просто следовать за звуком</span></p>
    <div class="e2-row">
      <p class="body">Ханг не требует музыкального образования, но вознаграждает за внимание к звуку. <span class="e2-hl">Мы поможем найти свой подход</span></p>
      <div class="e-item"><span class="mono">Первый урок</span><span>Без музыкального образования, своего инструмента и подготовки</span></div>
      <div class="e-item"><span class="mono">За 45 минут</span><span>Знакомство с инструментом, базовые приёмы и первая мелодия</span></div>
    </div>
  </div>
</section>

<!-- 03 · Что вы освоите: пять колонок-навыков -->
<section class="sec bg-dark on-dark e3" aria-labelledby="h-e3">
  <div class="g-head">
    <div class="sec-head">
      <span class="mono">03 · Что вы освоите</span>
      <h2 id="h-e3" class="h2">От первого звука <span class="mute">– к собственной музыке</span></h2>
    </div>
    <p class="g-note">На ханге легко начать. Но чтобы владеть инструментом, одной интуиции мало: соединяем технику, ритм, слух, мелодию и импровизацию</p>
  </div>
  <ol class="skills" lang="ru">
    {D.skills.map((s, i) => <li class="skill"><span class="mono skill-n">{pad(i + 1)}</span><span class="skill-w">{s.w}</span><span class="skill-t">{s.t}</span></li>)}
  </ol>
</section>

<!-- 04 · Как мы учим: пять ступеней растущей высоты -->
<section class="sec bg-sand e4" aria-labelledby="h-e4">
  <div class="g-head">
    <div class="sec-head">
      <span class="mono">04 · Как мы учим</span>
      <h2 id="h-e4" class="h2">Не просто набор <span class="mute">упражнений</span></h2>
    </div>
    <p class="g-note">Каждый этап добавляет новый уровень контроля: звук и движение, ритм и мелодия, затем импровизация и собственная музыкальная речь</p>
  </div>
  <ol class="stages" lang="ru">
    {D.stages.map((s, i) => <li class="stage" style={`--i:${i}`}><span class="mono stage-n">{pad(i + 1)}</span><span class="stack stage-b"><span class="stage-t">{s.h}</span><span class="stage-x">{s.t}</span></span></li>)}
  </ol>
  <span class="e4-more">+ сложные техники и приёмы, разные размеры, разборы композиций</span>
</section>

<!-- 05 · Как строится путь: 1–5 заголовок · 7–12 три этапа -->
<section class="sec bg-blue on-blue e5" aria-labelledby="h-e5">
  <div class="sec-head e5-l">
    <span class="mono">05 · Путь ученика</span>
    <h2 id="h-e5" class="h-display e5-h">Как строится путь</h2>
  </div>
  <ol class="path">
    {D.path.map(s => <li class="step"><span class="step-h"><span class="step-num">{s.n}</span><span class="mono">{s.u}</span></span><p>{s.t}</p></li>)}
  </ol>
</section>

<!-- 06 · Форматы и цены: 1–4 карточка пробного · 5–12 строки форматов -->
<section class="sec e6" id="formats" aria-labelledby="h-e6">
  <div class="g-head">
    <div class="sec-head">
      <span class="mono">06 · Форматы и цены</span>
      <h2 id="h-e6" class="h2">Выберите <span class="mute">свой темп</span></h2>
    </div>
    <p class="g-note">Не знаете, какой формат выбрать? Начните с пробного занятия – подскажем на месте</p>
  </div>
  <div class="e6-grid">
    <div class="trial on-dark">
      <div class="stack trial-t">
        <span class="mono">Начните отсюда</span>
        <h3 class="trial-name">Пробное занятие</h3>
        <span class="trial-x">Попробовать без обязательств. Инструмент дадим</span>
      </div>
      <div class="trial-price"><span>900 ₽</span><span class="mono">/ 45 мин</span></div>
      <button type="button" class="btn btn--52 btn--blue" data-open="trial">Записаться на пробное</button>
    </div>
    <div class="fmts">
      {D.formats.map(f => (
        <div class="fmt">
          <h3 class="fmt-name">{f.name}</h3>
          <span class="fmt-who">{f.who}</span>
          <span class="fmt-price"><span>{f.price}</span><span class="mono">{f.unit}</span></span>
          <button type="button" class="btn btn--44 btn--line fmt-btn" data-open={f.key}>Записаться</button>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 07 · Что нужно: 1–6 фото на всю высоту · 7–12 заголовок и 2×2 -->
<section class="sec bg-sand e7" aria-labelledby="h-e7">
  <div class="e-photo e7-photo"><img src={u('img/edu-51.webp')} alt="Ханги в студии школы" width="1200" height="1800" loading="lazy"></div>
  <div class="stack e7-r">
    <div class="sec-head">
      <span class="mono">07 · Перед первым занятием</span>
      <h2 id="h-e7" class="h2">Что нужно <span class="mute">для старта</span></h2>
    </div>
    <div class="needs">
      {NEEDS.map(n => <div class="need"><span class="mono">{n.label}</span><span class="need-big">{n.big}</span><span class="need-x">{n.text}</span></div>)}
    </div>
  </div>
</section>

<!-- 08 · Кто вас учит: чипы → 1–4 фото · 5–12 роль, имя, био в две колонки -->
<section class="sec bg-aubergine on-dark e8" id="teachers" aria-labelledby="h-e8">
  <div class="g-head">
    <div class="sec-head">
      <span class="mono">08 · Кто вас учит</span>
      <h2 id="h-e8" class="h2">Учимся у тех, кто двигает <span class="mute">культуру ханга вперёд</span></h2>
    </div>
    <p class="g-note">Наши преподаватели формировали российскую культуру ханга с самого начала и продолжают учиться у мастеров мировой сцены</p>
  </div>
  <div class="chips" role="tablist" aria-label="Преподаватели" data-tlist>
    {T.map((t, i) => <button type="button" class="chip" role="tab" id={`t-${i}`} aria-controls={`tp-${i}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{t.name}</button>)}
  </div>
  {T.map((t, i) => (
    <div class="tpanel" id={`tp-${i}`} role="tabpanel" aria-labelledby={`t-${i}`} tabindex="0" hidden={i > 0}>
      <div class="tphoto" data-pending-link={t.img ? undefined : 'P-13'}>
        {t.img ? <img src={u(t.img)} srcset={t.imgSmall ? `${u(t.imgSmall)} 480w, ${u(t.img)} 960w` : undefined} sizes="(min-width:1000px) 32vw, (min-width:360px) 320px, calc(100vw - 40px)" alt={`Портрет: ${t.name}`} width={t.imgWidth || 720} height={t.imgHeight || 960} loading="lazy"> : <span class="tmono" aria-hidden="true">{initials(t.name)}</span>}
      </div>
      <div class="stack tinfo">
        <span class="mono">{t.role}</span>
        <h3 class="tname">{t.name} {t.nick && <span class="mute">{t.nick}</span>}</h3>
        {/* описание: абзацы; у части преподавателей — вступление и список фактов (points) */}
        <div class="tbio">
          {t.bio.map(p => <p>{p}</p>)}
          {t.points && <ul class="tpoints">{t.points.map(x => <li>{x}</li>)}</ul>}
        </div>
        {(t.bio.length > 1 || t.points) && <button type="button" class="tmore" data-t-more aria-expanded="false">Читать дальше +</button>}
      </div>
    </div>
  ))}
</section>

<!-- 09 · Что говорят ученики — ждём реальные отзывы (P-E1), до тех пор экран скрыт -->
<section class="sec e9" aria-labelledby="h-e9" data-pending="P-E1">
  <div class="sec-head">
    <span class="mono">09 · Отзывы</span>
    <h2 id="h-e9" class="h2">Что говорят <span class="mute">ученики</span></h2>
  </div>
  <div class="revs">
    <div class="rev"><span class="mono">Отзыв · уточнить</span></div>
    <div class="rev"><span class="mono">Отзыв · уточнить</span></div>
    <div class="rev"><span class="mono">Отзыв · уточнить</span></div>
  </div>
</section>

<!-- 10 · Частые вопросы: 1–4 заголовок · 6–12 аккордеон; ответы в HTML, открыт первый -->
<section class="sec bg-sand e10" aria-labelledby="h-e10">
  <div class="stack e10-l">
    <span class="mono">10 · FAQ</span>
    <h2 id="h-e10" class="h2">Частые <span class="mute">вопросы</span></h2>
    <p class="g-note">Не нашли ответ? Спросите на пробном занятии или напишите нам</p>
  </div>
  <div class="faq" data-faq>
    {D.faq.map((f, i) => (
      <div class="faq-i">
        <h3><button type="button" class="faq-q" aria-expanded={String(i === 0)} aria-controls={`faq-${i}`}><span>{f.q}</span><span class="faq-sign" aria-hidden="true">{i === 0 ? '−' : '+'}</span></button></h3>
        <p class="faq-a" id={`faq-${i}`} hidden={i > 0}>{f.a}</p>
      </div>
    ))}
  </div>
</section>

<!-- 11 · Найди свой звук: тёмный финал, 1–8 заголовок · 9–12 запись и адреса -->
<section class="sec bg-dark on-dark e11" id="contacts" aria-labelledby="h-e11">
  <div class="glow e11-glow" aria-hidden="true"></div>
  <BrandLines class="brand-lines--learn" />
  <div class="e11-grid">
    <div class="stack e11-l">
      <span class="mono">11 · Пробное занятие · 900 ₽</span>
      <h2 id="h-e11" class="h-hero e11-h">
        <span>Найди</span>
        <span class="cap cap--hero e11-cap">свой звук</span>
        <span>за 45 минут</span>
      </h2>
    </div>
    <div class="stack e11-r">
      <button type="button" class="btn btn--blue e11-btn" data-open="trial">Записаться на пробное</button>
      {D.cities.map(c => (
        <div class="addr"><span class="mono">{c.name}</span>{c.address ? <span>{c.address}{c.metro && ` · ${c.metro}`}</span> : <span data-pending="P-02">Адрес – уточнить</span>}</div>
      ))}
    </div>
  </div>
  <BranchContacts />
  <footer class="efoot">
    <span>© U-GENE sound vibe · Москва · СПб</span>
    <nav class="efoot-nav" aria-label="Документы и разделы"><a class="lnk" href={u('politikaconfidencialnosti')}>Политика конфиденциальности</a><a class="lnk" href={home}>На главную →</a></nav>
  </footer>
</section>

</main>

<!-- липкая панель -->
<div class="bar bar--edu" data-sticky="520">
  <div class="glass-l bar-in">
    <div class="bar-txt"><span class="bar-name">Пробное занятие</span><span class="mono">900 ₽ · 45 мин</span></div>
    <button type="button" class="btn btn--48 btn--blue" data-open="trial">Записаться</button>
  </div>
</div>

<!-- форма записи: модалка / bottom sheet -->
<div class="sheet" data-sheet hidden>
  <div class="sheet-card" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <div class="sheet-head">
      <div class="sheet-title" id="sheet-title">Запись на занятие</div>
      <button type="button" class="x" data-close aria-label="Закрыть">×</button>
    </div>
    <LeadForm id="m" interest="trial" submit="Отправить" note="Перезвоним, ответим на вопросы и подберём время">
      <fieldset class="fs fld">
        <legend class="fl">Формат</legend>
        <div class="btns">
          {[['trial', 'Пробное'], ...D.formats.map(f => [f.key, f.chip])].map(([k, l], i) => (
            <label class="chip-r"><input type="radio" name="format" value={k} checked={i === 0}><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
    </LeadForm>
    <div class="stack thanks-box" data-thanks hidden tabindex="-1">
      <span class="sheet-title">Спасибо!</span>
      <span>Перезвоним в течение дня</span>
      <button type="button" class="btn btn--52 btn--ink" data-close>Закрыть</button>
    </div>
  </div>
</div>
</Base>
