---
// Главная. Тексты карточек, цифр, преподавателей и контактов собираются в HTML при сборке (SEO-MIGRATION.md, п. 1.10);
// home.js только переключает их. Данные — src/data/site.json, null = данных ещё нет (PENDING.md).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import BrandLines from '../components/BrandLines.astro';
import LeadForm from '../components/LeadForm.astro';
import BranchContacts from '../components/BranchContacts.astro';
import Quiz from '../components/Quiz.astro';
import QD from '../data/quiz.json';
import D from '../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const initials = (s: string) => s.split(/\s+/).map(w => w[0]).join('').slice(0, 2);
const fmtN = (n: number) => n >= 1000 ? n.toLocaleString('ru-RU') : String(n);
const pad = (n: number) => String(n).padStart(2, '0');
// hidden — преподаватель временно не показывается (Андрей Лето — добавим позже)
const TEACH = D.teachers.filter(t => !t.hidden);
const K = D.contacts;
const contacts = [
  { key: 'phone', label: K.phone || '+7 (___) ___-__-__', href: K.phone ? 'tel:+' + String(K.phone).replace(/\D/g, '') : null },
  { key: 'telegram', label: 'Telegram', href: K.telegram },
  { key: 'whatsapp', label: 'WhatsApp', href: K.whatsapp },
  { key: 'vk', label: 'ВКонтакте', href: K.vk },
  { key: 'youtube', label: 'YouTube', href: K.youtube }
].filter(c => c.href);
const msk = D.cities[0];
const mapQ = encodeURIComponent(`Москва, ${msk.address}`);

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://handpanshop.pro/#org', name: 'U-GENE sound vibe', alternateName: 'Handpan Shop',
      url: 'https://handpanshop.pro/', logo: 'https://handpanshop.pro/img/apple-touch-icon.png', foundingDate: '2019' },
    { '@type': 'WebSite', '@id': 'https://handpanshop.pro/#website', url: 'https://handpanshop.pro/', name: 'U-GENE sound vibe',
      inLanguage: 'ru', publisher: { '@id': 'https://handpanshop.pro/#org' } },
    { '@type': 'MusicStore', '@id': 'https://handpanshop.pro/#moscow', name: 'U-GENE sound vibe — студия в Москве',
      parentOrganization: { '@id': 'https://handpanshop.pro/#org' }, url: 'https://handpanshop.pro/',
      address: { '@type': 'PostalAddress', streetAddress: msk.address, addressLocality: 'Москва', addressCountry: 'RU' } }
  ]
};
---
<Base
  title="Ханги и школа игры на хэндпане в Москве и СПб — U-GENE sound vibe"
  description="Собственное производство хангов, школа и сообщество. Пробное занятие 45 минут — 900 ₽, инструмент даём, опыт не нужен. Москва и Санкт-Петербург."
  ogTitle="U-GENE sound vibe — найди свой звук"
  ogDescription="Ханги собственного производства, школа и сообщество. Пробное занятие — 900 ₽."
  path="/" ogImage="img/hero-scene-d.webp" theme="#0A1020"
  styles={['common.css', 'home.css', 'mobile.css']} scripts={['common.js', 'home.js']} jsonld={jsonld}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={u('img/hero-scene-m.webp')} media="(max-width:999.98px)" fetchpriority="high">
    <link rel="preload" as="image" href={u('img/hero-scene-d.webp')} media="(min-width:1000px)" fetchpriority="high">
  </Fragment>

<!-- 01 · Найди свой звук -->
<header class="s1 on-dark" id="top">
  <picture>
    <source media="(min-width:1000px)" srcset={u('img/hero-scene-d.webp')} width="1616" height="973">
    <img class="s1-bg" src={u('img/hero-scene-m.webp')} alt="Стальной ханг на мокром бетоне" width="1200" height="723" fetchpriority="high">
  </picture>
  <div class="s1-shade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="hdr">
    <Logo class="pill glass-d logo" href="#top" />
    <nav class="pill glass-d nav hdr-d" aria-label="Основное меню">
      <a class="lnk" href="#making">Инструменты</a><a class="lnk" href={u('cources')}>Обучение</a><a class="lnk" href="#contacts">Контакты</a>
    </nav>
    <div class="pill glass-d city s1-city hdr-d" role="group" aria-label="Город">
      <button type="button" data-city="msk" aria-pressed="true">Москва</button><button type="button" data-city="spb" aria-pressed="false">Санкт-Петербург</button>
    </div>
    <div class="hdr-n">
      <a class="pill glass-d city-short" href="#contacts">Москва · СПб</a>
      <span class="burger-slot" aria-hidden="true"></span>
    </div>
  </div>

  <div class="s1-body">
    <div class="stack s1-top">
      <!-- один H1: слоган + подзаголовок с ключевыми словами (SEO-MIGRATION.md, раздел 3); подзаголовок — первая фраза текста со 2-й колонки -->
      <h1 class="s1-h1">
        <span class="h-hero s1-slogan"><span>Найди</span> <span class="cap cap--hero s1-cap">Свой звук</span></span>
        <span class="s1-sub">Собственное производство хангов, школа и сообщество в Москве и Санкт-Петербурге.</span>
      </h1>
      <div class="stack s1-text">
        <p class="s1-lead">От первого касания до своей музыки – вместе с вами</p>
        <div class="btns s1-btns">
          <button type="button" class="btn btn--52 btn--blue s1-try" data-open="trial">Попробовать · 900 ₽</button>
          <a class="btn btn--52 btn--line-d" href="#making">Выбрать ханг</a>
        </div>
        <a class="s1-help" href={u('test')} data-quiz-open>Не знаете, с чего начать? Поможем определиться →</a>
        <button type="button" class="s1-play-n" data-play>
          <span class="play glass-d" data-play-ic aria-hidden="true"></span><span data-play-label data-off="Послушать ханг" data-on="Играет D Kurd">Послушать ханг</span>
        </button>
      </div>
    </div>
    <div class="s1-bottom hdr-d">
      <div class="s1-player">
        <button type="button" class="play glass-d s1-play" data-play aria-label="Послушать, как звучит ханг"></button>
        <div class="stack s1-pmeta">
          <span class="s1-plabel"><span data-play-label data-off="Послушать ханг" data-on="Играет D Kurd">Послушать ханг</span><span class="s1-ptime" data-time-wrap hidden> · <span data-time>0:00</span></span></span>
          <div class="wave" data-wave="40" aria-hidden="true"></div>
        </div>
      </div>
      <a class="s1-thumbs" href="#making" aria-label="Инструменты: больше 20 в студии">
        <img src={u('img/thumb-pedestal.webp')} alt="" width="120" height="120">
        <img src={u('img/thumb-hang.webp')} alt="" width="120" height="120">
        <span class="glass-d">20+<small>инструментов<br>в студии →</small></span>
      </a>
    </div>
  </div>
</header>

<nav class="menu" id="menu" hidden aria-label="Меню">
  <div class="menu-top">
    <Logo style="padding:0" />
    <button type="button" class="x" data-menu-close aria-label="Закрыть меню">×</button>
  </div>
  <div class="menu-links">
    <a href="#making">Инструменты</a><a href={u('cources')}>Обучение</a><a href="#" data-pending="P-12">Блог</a><a href="#contacts">Контакты</a>
  </div>
  <div class="btns" role="group" aria-label="Город">
    <button type="button" class="chip" data-city="msk" aria-pressed="true">Москва</button><button type="button" class="chip" data-city="spb" aria-pressed="false">Санкт-Петербург</button>
  </div>
</nav>
<button type="button" class="burger" aria-expanded="false" aria-controls="menu" aria-label="Меню"><span></span><span></span></button>

<main id="main">

<!-- 02 · Что такое ханг -->
<section class="s2 bg-blue on-blue" aria-labelledby="h-s2">
  <div class="mq-wrap s2-strip" aria-hidden="true"><div class="mq" data-marquee="HANG|ХАНГ|HANDPAN|ХЭНДПАН|PANTAM"></div></div>
  <div class="sec s2-grid">
    <div class="stack s2-text">
      <div class="mono">A · 2/10</div>
      <div class="s2-title">
        <h2 id="h-s2" class="h-display">Ханг</h2>
        <button type="button" class="ast" data-toggle="ast" aria-label="Что значит слово «ханг»">*</button>
      </div>
      <div class="s2-tip" data-panel="ast" hidden>Hang на бернском диалекте значит «рука». Так называется оригинальная модель из Швейцарии, а хэндпан – общее название подобных инструментов</div>
      <div class="s2-sub ind">перкуссия нового времени</div>
      <p class="body ind">Стальной инструмент, на котором вы одновременно задаёте ритм и ведёте мелодию. Поэтому его называют мелодической перкуссией</p>
      <div class="btns ind">
        <button type="button" class="btn btn--milk btn--wrap" data-open="visit">Прийти и послушать 20+ инструментов</button>
        <button type="button" class="btn btn--line-d" data-toggle="hist">История ханга <span data-sign>+</span></button>
      </div>
      <p class="body ind s2-more" data-panel="hist" hidden>Создан в Швейцарии в 2000 году Феликсом Ронером и Сабиной Шерер, основателями мастерской PANArt. Тёплый объёмный звук, похожий одновременно на арфу и хор</p>
    </div>
    <div class="s2-scheme">
      <div class="hang">
        <img class="hang-photo" src={u('img/handpan-fsharp-cutout.png')} alt="Хэндпан Фа-диез гармоник: вид на тональные поля" width="1254" height="1254" loading="lazy">
        <svg viewBox="0 0 400 400" data-hang role="group" aria-label="Интерактивный хэндпан: коснитесь тонального поля" aria-describedby="hang-sound-note"></svg>
      </div>
      <div class="mono">Коснитесь поля — услышите звук</div>
      <p class="hang-sound-note" id="hang-sound-note">Синтезированный пример звучания</p>
    </div>
  </div>
</section>

<!-- 03 · Почему так легко -->
<section class="sec s3 bg-sand" aria-labelledby="h-s3">
  <div class="stack s3-text">
    <span class="mono s3-count">B♭ · 3/10</span>
    <div class="s3-heading">
      <div class="s3-info" data-sculpture>
        <button type="button" class="mono s3-info-trigger" aria-expanded="false" aria-controls="sculpture-note" data-sculpture-trigger>
          <span>Звуковая</span><span>скульптура</span><span class="s3-info-dot" aria-hidden="true"></span>
        </button>
        <div class="s3-info-panel" id="sculpture-note" role="region" aria-label="Почему ханг называют звуковой скульптурой" tabindex="0" hidden>
          <button type="button" class="s3-info-close" aria-label="Закрыть пояснение" data-sculpture-close>×</button>
          <p>Сами создатели называют ханг «звуковой скульптурой», рассматривая его как художественное произведение, с которым вступаешь в диалог. В руководстве PANArt писали: не ставьте целью мелодию или ритм. Следуйте за звуком и ощущением прикосновения.</p>
          <p>С тех пор, конечно, ханг вышел далеко за пределы этого интуитивного подхода: его используют в академической музыке, неоклассике, электронике и кино. Исполнители мирового уровня — от сольных перкуссионистов до оркестровых проектов — играют на нём на больших сценах и в студиях. Это полноправный голос современной музыки.</p>
          <p>И всё же суть осталась прежней: вы можете играть легко. И вот почему:</p>
        </div>
      </div>
      <h2 id="h-s3" class="h2 stack"><span>Почему</span><span>так</span><span>легко?</span></h2>
    </div>
    <p class="body">Внутри каждого ханга ноты выстроены в ладовую систему — гармоническая архитектура, где все звуки связаны. Вы не можете сыграть «неправильно» — инструмент сам ведёт к гармонии. Можно интуитивно выводить руки по полям, и это уже будет музыкальная фраза.</p>
    <p class="body body--2">За несколько занятий, без опыта, вы начинаете импровизировать, звучать гармонично и чувствовать себя творцом. Именно это мы называем «найти свой звук». Состояние, когда музыка рождается естественно, а вы просто наслаждаетесь процессом.</p>
    <p class="s3-support">Мы помогаем найти ваш звук. И сопровождаем на каждом этапе музыкального развития.</p>
    <div class="btns">
      <button type="button" class="btn btn--blue btn--full-n" data-open="trial">Записаться на обучение</button>
    </div>
  </div>
  <div class="s3-photo">
    <img src={u('img/easy-m.webp')} alt="Руки на ханге" width="733" height="1100" loading="lazy">
    <div class="s3-chip">Первое занятие · без опыта</div>
  </div>
</section>

<!-- 04 · Три маршрута -->
<section class="sec s4" aria-labelledby="h-s4">
  <BrandLines class="brand-lines--routes" />

  <div class="head-row">
    <div class="sec-head">
      <div class="mono">C · 4/10</div>
      <h2 id="h-s4" class="h2"><span>Как начать</span> <span class="s4-title-indent"><em>знакомство</em><br>с хангом?</span></h2>
    </div>
    <p class="small s4-note">Не знаете, какой маршрут ваш? Начните с любого, остальное подскажем на месте</p>
  </div>
  <div class="routes">
    <div class="route">
      <img class="route-photo" src={u('img/aud-home.webp')} alt="Ханг в студии" width="720" height="900" loading="lazy">
      <h3 class="route-verb">Услышать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу сначала послушать</span>
        <span>Частный визит в студию: 20+ инструментов разных строёв, можно играть на каждом. Без обязательств и без покупки</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="visit">Записаться на визит →</button>
    </div>
    <div class="route">
      <img class="route-photo" src={u('img/easy-d.webp')} alt="Первое знакомство с хангом на занятии" width="720" height="900" loading="lazy">
      <h3 class="route-verb">Попробовать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу взять инструмент в руки</span>
        <span>Пробное занятие с преподавателем: 45 минут, 900 ₽. Инструмент даём, опыт не нужен</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="trial">Попробовать занятие →</button>
    </div>
    <div class="route">
      <img class="route-photo" src={u('img/making.webp')} alt="Работа мастера над хангом" width="720" height="900" loading="lazy">
      <h3 class="route-verb">Выбрать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу свой ханг</span>
        <span>Консультация мастера: строй, сталь, количество нот, бюджет. Покажем инструменты в наличии и под заказ</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="buy">Получить консультацию →</button>
    </div>
  </div>
</section>

<!-- 05 · Все шесть аудиторий: карточки с рекомендацией и звуком -->
<section class="sec s5 bg-sand" aria-labelledby="h-s5">
  <div class="sec-head">
    <div class="mono">D · 5/10</div>
    <h2 id="h-s5" class="h2 s5-h"><span>Кому подходит ханг</span><br>– от медитации до сцены</h2>
  </div>
  <div class="audiences">
    {D.audiences.map((a, i) => (
      <article class="aud" id={`aud-${i}`} data-snd={a.snd}>
        <h3 class="aud-name">{a.name}</h3>
        <p class="aud-text">{a.text}</p>
        <div class="aud-bottom">
          {a.rec
            ? <p class="aud-rec"><span>Рекомендуем</span><br>{a.rec}</p>
            : <p class="aud-rec" data-pending={a.recPending}>Рекомендация уточняется</p>}
          <button type="button" class="play aud-play" data-aud-play aria-label={`Пример звучания: ${a.name}`}><svg viewBox="0 0 22 22" aria-hidden="true"><path d="M6 3 L19 11 L6 19 Z" fill="currentColor"/></svg></button>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- 06 · Почему доверяют -->
<section class="sec s6" aria-labelledby="h-s6" data-stats-wrap>
  <div class="sec-head">
    <div class="mono">E · 6/10</div>
    <h2 id="h-s6" class="h2 h2--long s6-h"><span class="s6-accent">Мастера,</span> которые стоят <span class="s6-indent">у истоков культуры<br>ханга в России</span></h2>
  </div>
  <div class="s6-grid">
    <div class="s6-num" aria-hidden="true"><div class="s6-col" data-stat-col>
      {D.stats.map(s => <span>{fmtN(s.n)}{s.suf}</span>)}
    </div></div>
    <div class="stack s6-side">
      <p class="s6-label" data-stat-label aria-live="polite">
        {D.stats.map((s, i) => <span hidden={i > 0}><span class="sr">{fmtN(s.n)}{s.suf} </span>{s.label}</span>)}
      </p>
      <div class="s6-dots">
        <div class="s6-dots-in" data-stat-dots role="group" aria-label="Цифры">
          {D.stats.map((s, i) => <button type="button" class="s6-dot" aria-label={`Цифра ${i + 1}: ${fmtN(s.n)}${s.suf}`}></button>)}
        </div>
        <span class="mono s6-count" data-stat-count>01 / {pad(D.stats.length)}</span>
      </div>
    </div>
  </div>
  <span class="mono s6-note" data-pending="P-04">Цифры – уточнить</span>
</section>

<!-- 07 · Кто учит -->
<section class="sec s7" id="teach" aria-labelledby="h-s7">
  <div class="head-row">
    <div class="sec-head">
      <div class="mono">F · 7/10</div>
      <h2 id="h-s7" class="h-display">Кто учит</h2>
    </div>
    <p class="small s7-note">Научиться можно с нуля, в любом возрасте и без музыкального опыта. Главное – преподаватель, который слышит вас</p>
  </div>
  <div class="tcar bleed" data-tcar aria-roledescription="карусель" aria-label="Преподаватели">
    {TEACH.map((p, i) => (
      <button type="button" class="tcard" data-i={i} aria-label={p.name}>
        {p.img
          ? <img src={u(p.img)} srcset={p.imgSmall ? `${u(p.imgSmall)} 480w, ${u(p.img)} 960w` : undefined} sizes="(min-width:1000px) 26vw, 62vw" alt={`Портрет: ${p.name}`} width={p.imgWidth || 720} height={p.imgHeight || 960} loading="lazy">
          : <span class="tcard-ini" aria-hidden="true" data-pending-link="P-13">{initials(p.name)}</span>}
        <span class="tcard-shade"></span>
        <span class="tcard-cap"><span class="tcard-name">{p.name}</span><span class="tcard-role">{p.roleShort}</span></span>
      </button>
    ))}
  </div>
  <div class="tnav">
    <button type="button" class="arr" data-t-prev aria-label="Предыдущий преподаватель">←</button>
    <span class="mono tcount" data-t-count aria-live="polite">01 / {pad(TEACH.length)}</span>
    <button type="button" class="arr arr--ink" data-t-next aria-label="Следующий преподаватель">→</button>
  </div>
  <div class="btns">
    <button type="button" class="btn btn--blue btn--full-n" data-open="trial">Записаться на пробное занятие</button>
    <a class="btn btn--line btn--wrap" href={u('cources#teachers')}>Все преподаватели и форматы →</a>
  </div>
</section>

<!-- 08 · Как делают ханг -->
<section class="s8 bg-dark on-dark" id="making" aria-labelledby="h-s8">
  <img class="s8-bg" src={u('img/making.webp')} alt="" width="1200" height="1800" loading="lazy">
  <div class="sec s8-grid">
    <div class="stack s8-text">
      <div class="s8-top">
        <span class="s8-chip" data-pending="P-09">Видео из мастерской</span>
        <span class="mono">G · 8/10</span>
      </div>
      <span class="s8-sub">Ханг нельзя сделать на конвейере</span>
      <h2 id="h-s8" class="h-display stack"><span>Десятки</span><span>тысяч</span><span class="s8-hl">ударов</span></h2>
    </div>
    <div class="stack s8-copy">
      <p class="body">Его создают руками, снова и снова возвращаясь к каждому звуку. На настройку одной ноты уходит от 200 до нескольких тысяч касаний</p>
      <div class="s8-plate">Вы покупаете время мастеров, вложенное в каждый удар</div>
      <div class="btns">
        <a class="btn btn--milk s8-btn" href="#" data-pending="P-12">Смотреть инструменты</a>
        <button type="button" class="btn btn--line-d s8-btn" data-open="help">Помочь выбрать</button>
      </div>
    </div>
  </div>
</section>

<!-- 09 · Ханг объединяет -->
<section class="sec s9" id="community" aria-labelledby="h-s9">
  <div class="s9-grid">
    <div class="stack s9-text">
      <div class="mono">A · 9/10</div>
      <h2 id="h-s9" class="h2 stack"><span>Ханг</span><span>объединяет</span></h2>
      <p class="s9-intro">Круг, где ты становишься частью культуры.</p>
      <p class="body">Хэндпан-сообщества — одни из самых гостеприимных в мире музыки.</p>
      <h3 class="accent">Почему?</h3>
      <p class="body">Потому что здесь ценится не статус, опыт или уровень мастерства, а сам интерес к звуку. На одном джеме могут встретиться виртуоз, человек с первым хангом и тот, кто пришёл просто послушать.</p>
      <p class="body">Это культура, в которой знания передают друг другу, музыкой делятся, а знакомства легко превращаются в дружбу и совместные проекты.</p>
      <p class="body">Джемы, концерты, выезды, фестивали, встречи с мастерами и музыкантами. Доступ к самым актуальным событиям и знаниям. Люди, с которыми хочется продолжать играть уже за пределами музыки.</p>
      <span class="accent ind s9-acc">Ты приходишь за звуком. А находишь своё окружение</span>
      {D.communityUrl
        ? <a class="btn btn--ink s9-btn" href={D.communityUrl}>Присоединиться к комьюнити →</a>
        : <button type="button" class="btn btn--ink s9-btn" data-open="community">Присоединиться к комьюнити →</button>}
    </div>
    <div class="mosaic">
      <div class="m m1"><img src={u('img/community-1.webp')} alt="Зал аплодирует на концерте школы" width="1200" height="800" loading="lazy"></div>
      <div class="m m2"><img src={u('img/community-2.webp')} alt="Ансамбль хангов на отчётном концерте" width="667" height="1000" loading="lazy"></div>
      <div class="m m3"><img src={u('img/community-3.webp')} alt="Игра на хангах в поле у маяка" width="600" height="900" loading="lazy"></div>
    </div>
  </div>
</section>

<!-- 10 · Финал и контакты -->
<section class="sec s10" id="contacts" aria-labelledby="h-s10">
  <div class="glow s10-glow" aria-hidden="true"></div>
  <BrandLines class="brand-lines--contact" />
  <div class="stack s10-head">
    <div class="mono row-sb"><span>Пробное занятие</span><span>C · 10/10</span></div>
    <h2 id="h-s10" class="h-hero s10-h">
      <span class="s10-l1"><span>Найди</span> <span class="cap cap--blue">свой</span> <span>звук</span></span>
      <span class="s10-l2">за 45 минут</span>
    </h2>
  </div>
  <div class="s10-grid">
    <div class="glass-l s10-form">
      <p class="s10-lead">Пробное занятие – 900 ₽. Инструмент даём, опыт не нужен</p>
      <div data-final><LeadForm id="f" interest="trial" /></div>
      <div class="thanks" data-thanks hidden tabindex="-1">Спасибо! Перезвоним в течение дня</div>
    </div>
    <div class="stack s10-side">
      <div class="s10-cities">
        {D.cities.map(c => (
          <div class="cityc">
            <div class="cityc-n">{c.name}</div>
            {c.address
              ? <div class="cityc-a">{c.address}{c.metro && <Fragment><br>{c.metro}</Fragment>}</div>
              : <div class="cityc-a" data-pending="P-02">Адрес – уточнить</div>}
          </div>
        ))}
      </div>
      <!-- карта: виджет Яндекса грузится только по клику — он тяжёлый (SEO-MIGRATION.md, раздел 9) -->
      <div class="s10-map" data-map={`https://yandex.ru/map-widget/v1/?text=${mapQ}&z=16`}>
        <span class="contour contour--inner map-line" aria-hidden="true"></span>
        <div class="map-in">
          <span class="mono">Москва · студия</span>
          <span class="map-addr">{msk.address}{msk.metro && `, ${msk.metro}`}</span>
          <div class="btns">
            <button type="button" class="btn btn--48 btn--ink" data-map-show>Показать карту</button>
            <a class="btn btn--48 btn--line" href={`https://yandex.ru/maps/?text=${mapQ}`} target="_blank" rel="noopener">Открыть в Яндекс Картах</a>
          </div>
        </div>
      </div>
      {contacts.length > 0 && <div class="s10-contacts">
        {contacts.map(c => <a href={c.href} target={c.key === 'phone' ? undefined : '_blank'} rel={c.key === 'phone' ? undefined : 'noopener'}>{c.label}</a>)}
      </div>}
    </div>
  </div>
  <BranchContacts />
  <footer class="foot">
    <Logo class="foot-logo" />
    <div class="foot-links"><a class="lnk" href="#" data-pending="P-10">Политика конфиденциальности</a><a class="lnk" href="#" data-pending="P-10">Договор оферты</a></div>
  </footer>
</section>

</main>

<!-- липкая панель -->
<div class="bar" data-sticky="560">
  <div class="glass-l bar-in">
    <div class="bar-l">
      <button type="button" class="play bar-play" data-play aria-label="Послушать, как звучит ханг"></button>
      <div class="stack bar-meta">
        <div class="bar-row"><span class="bar-t">Как звучит ханг</span><span class="bar-time" data-time>0:00</span></div>
        <div class="bar-prog"><div data-progress></div></div>
      </div>
    </div>
    <button type="button" class="btn btn--48 btn--blue" data-open="trial">Записаться</button>
  </div>
</div>

<!-- форма записи: модалка / bottom sheet -->
<div class="sheet" data-sheet hidden>
  <div class="sheet-card" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <div class="sheet-head">
      <div class="sheet-title" id="sheet-title" data-sheet-title></div>
      <button type="button" class="x" data-close aria-label="Закрыть">×</button>
    </div>
    <p class="small body--2" data-sheet-help hidden>Можно начать с обучения, взять инструмент в аренду или сразу выбрать свой. Оставьте контакты – подскажем, с чего начать именно вам</p>
    <LeadForm id="m" />
    <p class="thanks" data-thanks hidden tabindex="-1">Спасибо! Перезвоним в течение дня</p>
  </div>
</div>
<!-- тест «Поможем определиться» в окне; quiz.js грузится по кнопке, без JS ссылка ведёт на /test -->
<div class="sheet qsheet" data-quiz-modal hidden>
  <div class="sheet-card qsheet-card" role="dialog" aria-modal="true" aria-labelledby="qm-title">
    <div class="sheet-head">
      <div class="sheet-title" id="qm-title">С чего вам начать</div>
      <button type="button" class="x" data-quiz-close aria-label="Закрыть">×</button>
    </div>
    <p class="small">{QD.intro}</p>
    <Quiz id="hq" />
  </div>
</div>
</Base>
