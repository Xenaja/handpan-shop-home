---
// Главная. Тексты карточек, цифр, преподавателей и контактов собираются в HTML при сборке (SEO-MIGRATION.md, п. 1.10);
// home.js только переключает их. Данные — src/data/site.json, null = данных ещё нет (PENDING.md).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import BrandLines from '../components/BrandLines.astro';
import LeadForm from '../components/LeadForm.astro';
import BranchContacts from '../components/BranchContacts.astro';
import Quiz from '../components/Quiz.astro';
import QD from '../data/quiz.json';
import D from '../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const initials = (s: string) => s.split(/\s+/).map(w => w[0]).join('').slice(0, 2);
const fmtN = (n: number) => n >= 1000 ? n.toLocaleString('ru-RU') : String(n);
const pad = (n: number) => String(n).padStart(2, '0');
// hidden — преподаватель временно не показывается (Андрей Лето — добавим позже)
const TEACH = D.teachers.filter(t => !t.hidden);
const msk = D.cities[0], spb = D.cities.find(c => c.key === 'spb');
// фото ленты «Ханг объединяет» (правка 14.11)
const COMM = [
  { src: 'img/community-hands.webp', w: 1400, h: 1129, alt: 'Руки на хангах: игра в кругу на траве' },
  { src: 'img/community-workshop.webp', w: 1350, h: 900, alt: 'Мастер-класс по игре на ханге на открытом воздухе' },
  { src: 'img/community-concert-1.webp', w: 1350, h: 900, alt: 'Отчётный концерт школы: зал поддерживает исполнительницу' },
  { src: 'img/community-team.webp', w: 720, h: 900, alt: 'Музыкант с хангом в руках улыбается' },
  { src: 'img/community-clap.webp', w: 2000, h: 1073, alt: 'Слушатели аплодируют на концерте школы' },
  { src: 'img/community-concert-2.webp', w: 1350, h: 900, alt: 'Преподаватель на отчётном концерте школы' },
  { src: 'img/community-concert-3.webp', w: 600, h: 900, alt: 'Зрители аплодируют на отчётном концерте' },
  { src: 'img/community-concert-4.webp', w: 1350, h: 900, alt: 'Зрители слушают концерт школы' }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://handpanshop.pro/#org', name: 'U-GENE sound vibe', alternateName: 'Handpan Shop',
      url: 'https://handpanshop.pro/', logo: 'https://handpanshop.pro/img/apple-touch-icon.png', foundingDate: '2019' },
    { '@type': 'WebSite', '@id': 'https://handpanshop.pro/#website', url: 'https://handpanshop.pro/', name: 'U-GENE sound vibe',
      inLanguage: 'ru', publisher: { '@id': 'https://handpanshop.pro/#org' } },
    { '@type': 'MusicStore', '@id': 'https://handpanshop.pro/#moscow', name: 'U-GENE sound vibe — студия в Москве',
      parentOrganization: { '@id': 'https://handpanshop.pro/#org' }, url: 'https://handpanshop.pro/',
      telephone: msk.contacts?.phone, email: msk.contacts?.email,
      address: { '@type': 'PostalAddress', streetAddress: msk.address, addressLocality: 'Москва', addressCountry: 'RU' },
      geo: msk.coords ? { '@type': 'GeoCoordinates', latitude: msk.coords[1], longitude: msk.coords[0] } : undefined },
    // филиал в Петербурге (SEO-MIGRATION.md, раздел 7: MusicStore ×2); у филиала свой сайт
    { '@type': 'MusicStore', '@id': 'https://handpanshop.pro/#spb', name: 'U-GENE sound vibe — студия в Санкт-Петербурге',
      parentOrganization: { '@id': 'https://handpanshop.pro/#org' }, url: spb.contacts?.website || D.spbSite,
      telephone: spb.contacts?.phone, email: spb.contacts?.email,
      address: { '@type': 'PostalAddress', streetAddress: spb.address, addressLocality: 'Санкт-Петербург', addressCountry: 'RU' },
      geo: spb.coords ? { '@type': 'GeoCoordinates', latitude: spb.coords[1], longitude: spb.coords[0] } : undefined }
  ]
};
---
<Base
  title="Ханги и школа игры на хэндпане в Москве и СПб — U-GENE sound vibe"
  description="Собственное производство хангов, школа и сообщество. Пробное занятие 45 минут — 900 ₽, инструмент даём, опыт не нужен. Москва и Санкт-Петербург."
  ogTitle="U-GENE sound vibe — найди свой звук"
  ogDescription="Ханги собственного производства, школа и сообщество. Пробное занятие — 900 ₽."
  path="/" ogImage="img/hero-scene-d.webp" theme="#0A1020"
  styles={['common.css', 'home.css', 'mobile.css']} scripts={['common.js', 'home.js']} jsonld={jsonld}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={u('img/hero-hands-m.webp')} media="(max-width:999.98px)" fetchpriority="high">
    <link rel="preload" as="image" href={u('img/hero-hands-d.webp')} media="(min-width:1000px)" fetchpriority="high">
  </Fragment>

<!-- 01 · Найди свой звук -->
<header class="s1 on-dark" id="top">
  <!-- фото по правке 11.11: руки на ханге; плеер стоит на самом инструменте (точка — доли кадра, home.js) -->
  <picture>
    <source media="(min-width:1000px)" srcset={u('img/hero-hands-d.webp')} width="2400" height="1408">
    <img class="s1-bg" src={u('img/hero-hands-m.webp')} alt="Руки музыканта на ханге" width="1200" height="939" fetchpriority="high" data-spot-d="0.66,0.75" data-spot-m="0.3,0.8">
  </picture>
  <!-- видео-фон (правка 14.11): крупные планы из «Играем в студии»; на компьютере горизонтальная версия, на телефоне вертикальная;
       фото под ним остаётся заставкой и опорой для плеера «Послушай» -->
  <video class="s1-vid" muted loop playsinline preload="none" aria-hidden="true"
    data-src-d={u('video/hero-d.mp4')} data-src-m={u('video/hero-m.mp4')} data-poster-d={u('video/hero-d.jpg')} data-poster-m={u('video/hero-m.jpg')}></video>
  <div class="s1-shade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="hdr">
    <Logo class="pill glass-d logo" href="#top" />
    <nav class="pill glass-d nav hdr-d" aria-label="Основное меню">
      <a class="lnk" href={u('cources')}>Обучение</a><a class="lnk" href={u('instruments')}>Инструменты</a><a class="lnk" href="#contacts">Контакты</a>
    </nav>
    <!-- Петербург — отдельный сайт филиала (правка 08.11) -->
    <div class="pill glass-d city s1-city hdr-d" role="group" aria-label="Город">
      <button type="button" data-city="msk" aria-pressed="true">Москва</button><a href={D.spbSite} target="_blank" rel="noopener">Санкт-Петербург</a>
    </div>
    <div class="hdr-n">
      <a class="pill glass-d city-short" href="#contacts">Москва · СПб</a>
      <span class="burger-slot" aria-hidden="true"></span>
    </div>
  </div>

  <div class="s1-body">
    <div class="stack s1-top">
      <!-- один H1: слоган + подзаголовок с ключевыми словами (SEO-MIGRATION.md, раздел 3); подзаголовок — первая фраза текста со 2-й колонки -->
      <h1 class="s1-h1">
        <span class="h-hero s1-slogan"><span>Найди</span> <span class="cap cap--hero s1-cap">Свой звук</span></span>
        <span class="s1-sub">Собственное производство хангов, школа и сообщество в Москве и Санкт-Петербурге.</span>
      </h1>
      <div class="stack s1-text">
        <p class="s1-lead">От первого касания до своей музыки — мы проходим этот путь вместе с вами.</p>
        <div class="btns s1-btns">
          <button type="button" class="btn btn--52 btn--line-d s1-try" data-open="trial">Попробовать занятие</button>
          <button type="button" class="btn btn--52 btn--blue" data-open="buy">Выбрать ханг</button>
        </div>
        <a class="s1-help" href={u('test')} data-quiz-open>Не знаете, с чего начать? Поможем определиться →</a>
      </div>
    </div>
    <div class="s1-bottom hdr-d">
      <!-- миниатюры убраны: не сочетались (правка 05.11) -->
      <a class="s1-thumbs" href="#making" aria-label="Инструменты: больше 20 в студии">
        <span class="glass-d">20+<small>инструментов<br>в студии →</small></span>
      </a>
    </div>
  </div>
  <!-- плеер на ханге (правка 11.11) -->
  <button type="button" class="s1-hangplay glass-d" data-play data-hang-spot aria-label="Послушать, как звучит ханг">
    <span class="play glass-d" data-play-ic aria-hidden="true"></span>
    <span class="s1-hp-label"><span data-play-label data-off="Послушай" data-on="Играет U-GENE">Послушай</span><span class="s1-ptime" data-time-wrap hidden> · <span data-time>0:00</span></span></span>
  </button>
</header>

<nav class="menu" id="menu" hidden aria-label="Меню">
  <div class="menu-top">
    <Logo style="padding:0" />
    <button type="button" class="x" data-menu-close aria-label="Закрыть меню">×</button>
  </div>
  <div class="menu-links">
    <a href={u('cources')}>Обучение</a><a href={u('instruments')}>Инструменты</a><a href="#" data-pending="P-12">Блог</a><a href="#contacts">Контакты</a>
  </div>
  <div class="btns" role="group" aria-label="Город">
    <button type="button" class="chip" data-city="msk" aria-pressed="true">Москва</button><a class="chip" href={D.spbSite} target="_blank" rel="noopener">Санкт-Петербург ↗</a>
  </div>
</nav>
<button type="button" class="burger" aria-expanded="false" aria-controls="menu" aria-label="Меню"><span></span><span></span></button>

<main id="main">

<!-- 02 · Что такое ханг -->
<section class="s2 bg-grad on-blue" aria-labelledby="h-s2">
  <div class="mq-wrap s2-strip" aria-hidden="true"><div class="mq" data-marquee="HANG|ХАНГ|HANDPAN|ХЭНДПАН|PANTAM"></div></div>
  <div class="sec s2-grid">
    <div class="stack s2-text">
      <div class="mono">A · 2/10</div>
      <div class="s2-title">
        <h2 id="h-s2" class="h-display">Ханг</h2>
        <!-- звёздочка заменена пульсацией (правка 05.11) -->
        <button type="button" class="ast" data-pop-btn="ast" data-pulse-hint aria-label="Что значит слово «ханг»"><span class="ast-pulse" aria-hidden="true"></span></button>
        <!-- справка — мягкий попап у точки вместо резко раскрывающейся плашки (правка 14.11) -->
        <div class="s2-pop" id="pop-ast" data-pop="ast" role="note">Hang на бернском диалекте значит «рука». Так называется оригинальная модель из Швейцарии, а хэндпан – общее название подобных инструментов</div>
      </div>
      <div class="s2-sub ind">перкуссия нового времени</div>
      <p class="body ind">Мелодический идиофон из стали – ханг, он же хэндпан. Этот инструмент уникален: играя на нем, вы получаете одновременно ритмический акцент и мелодическую ноту. Тёплый, объёмный звук, похожий одновременно на арфу и хор.</p>
      <p class="body ind">Это инструмент, который хочется не просто слушать – к нему хочется прикоснуться.</p>
      <div class="btns ind">
        <button type="button" class="btn btn--milk btn--wrap" data-open="visit">Прийти и послушать в студии</button>
        <button type="button" class="btn btn--line-d" data-toggle="hist">История ханга <span data-sign>+</span></button>
      </div>
      <p class="body ind s2-more" data-panel="hist" hidden>Создан в Швейцарии в 2000 году Феликсом Ронером и Сабиной Шерер, основателями мастерской PANArt. Две соединённые стальные полусферы: в центре — «динг» (Ding), основной тон, вокруг — тональные поля. Снизу — «гу» (Gu), резонатор Гельмгольца, который даёт глубокий бас.</p>
    </div>
    <div class="s2-scheme">
      <!-- только иридисцентный (правка 11.11); переключатель сравнения убран -->
      <div class="hang">
        <img class="hang-photo" src={u('img/handpan-iridescent-cutout.webp')} alt="Иридисцентный хэндпан: вид сверху на тональные поля" width="878" height="878" loading="lazy">
        <svg viewBox="0 0 400 400" data-hang role="group" aria-label="Интерактивный хэндпан: коснитесь тонального поля" aria-describedby="hang-sound-note"></svg>
      </div>
      <div class="mono">Коснитесь поля — услышьте звук</div>
      <p class="hang-sound-note" id="hang-sound-note">Синтезированный пример звучания</p>
      <a class="btn btn--line-d s2-sim" href="#" data-pending="P-14">Симулятор ханга 👆</a>
    </div>
  </div>
</section>

<!-- 03 · Почему так легко -->
<section class="sec s3 bg-white" aria-labelledby="h-s3">
  <div class="stack s3-text">
    <span class="mono s3-count">B♭ · 3/10</span>
    <!-- текст целиком по правке 13.11 (ANN, №61): «или» из заголовка убрано -->
    <h2 id="h-s3" class="h2 s3-h"><span class="s3-kick">Звуковая скульптура</span> <span class="s3-q">Почему так легко играть?</span></h2>
    <p class="body">Создатели PANArt называли ханг «звуковой скульптурой» и предлагали:</p>
    <blockquote class="s3-quote">«Не ставить целью мелодию, а следовать за звуком и ощущением прикосновения».</blockquote>
    <p class="body body--2">С тех пор ханг вышел далеко за пределы интуитивного подхода: сегодня он звучит на больших сценах, его используют в академической музыке, неоклассике, электронике и кино.</p>
    <p class="body"><strong>Но главное осталось неизменным: играть может каждый.</strong></p>
    <p class="body">Ноты ханга подобраны в единую гармоническую систему. Поэтому даже без музыкального образования можно интуитивно создавать собственные мелодии.</p>
    <div class="btns">
      <button type="button" class="btn btn--blue btn--full-n" data-open="trial">Попробовать урок</button>
    </div>
    <p class="body body--2">За несколько занятий вы начнёте импровизировать, звучать гармонично и чувствовать себя творцом.</p>
    <p class="s3-support">А мы — поможем найти ваш звук. И сопроводим на каждом этапе вашего музыкального развития.</p>
  </div>
  <div class="s3-photo">
    <img src={u('img/easy-m.webp')} alt="Руки на ханге" width="733" height="1100" loading="lazy">
    <div class="s3-chip">Первое занятие · без опыта</div>
  </div>
</section>

<!-- 04 · Три маршрута -->
<section class="sec s4 bg-grad" aria-labelledby="h-s4">
  <BrandLines class="brand-lines--routes" />

  <div class="head-row">
    <div class="sec-head">
      <div class="mono">C · 4/10</div>
      <h2 id="h-s4" class="h2"><span>Как начать</span> <span class="s4-title-indent"><em>знакомство</em><br>с хангом?</span></h2>
    </div>
  </div>
  <!-- раскладка по макету 11.11: три фото в ряд сразу под заголовком, от левого поля, по верхнему краю -->
  <div class="routes">
    <div class="route">
      <img class="route-photo" src={u('img/route-engraved.webp')} alt="Руки на ханге с гравировкой" width="1092" height="942" loading="lazy">
      <h3 class="route-verb">Услышать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу сначала послушать</span>
        <span>Частный визит в студию: 20+ инструментов разных строёв, можно играть на каждом. Без обязательств и без покупки</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="visit">Записаться на визит →</button>
    </div>
    <div class="route">
      <img class="route-photo" src={u('img/easy-d.webp')} alt="Первое знакомство с хангом на занятии" width="720" height="900" loading="lazy">
      <h3 class="route-verb">Попробовать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу взять инструмент в руки</span>
        <span>Пробное занятие с преподавателем: 45 минут, 900 ₽. Инструмент даём, опыт не нужен</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="trial">Попробовать занятие →</button>
    </div>
    <div class="route">
      <img class="route-photo" src={u('img/route-tuning2.webp')} alt="Мастер настраивает ноты ханга по меловой разметке" width="1200" height="1044" loading="lazy">
      <h3 class="route-verb">Выбрать</h3>
      <div class="stack route-info">
        <span class="mono">Хочу свой ханг</span>
        <span>Консультация мастера: строй, сталь, количество нот, бюджет. Покажем инструменты в наличии и под заказ</span>
      </div>
      <button type="button" class="btn btn--52 btn--line route-btn" data-open="buy">Получить консультацию →</button>
    </div>
  </div>
  <p class="small s4-note">Не знаете, какой маршрут ваш? Начните с любого, остальное подскажем на месте</p>
</section>

<!-- 05 · Все шесть аудиторий: карточки с рекомендацией и звуком -->
<section class="sec s5 bg-sky" aria-labelledby="h-s5">
  <div class="sec-head">
    <div class="mono">D · 5/10</div>
    <h2 id="h-s5" class="h2 s5-h"><span>Кому подходит ханг</span><br>– от медитации до сцены</h2>
  </div>
  <div class="audiences">
    {D.audiences.map((a, i) => (
      <article class="aud" id={`aud-${i}`} data-snd={a.snd}>
        <h3 class="aud-name">{a.name}</h3>
        <p class="aud-text">{a.text}</p>
        {a.fit && <p class="aud-fit"><span>Подходит:</span> {a.fit}</p>}
        <div class="aud-bottom">
          {a.rec
            ? <p class="aud-rec"><span>Рекомендуем</span><br>{a.rec}</p>
            : <p class="aud-rec" data-pending={a.recPending}>Рекомендация уточняется</p>}
          <button type="button" class="aud-play aud-play--mark" data-aud-play aria-label={`Пример звучания: ${a.name}`}><i class="logo-mark" aria-hidden="true"></i></button>
        </div>
      </article>
    ))}
  </div>
  <!-- две кнопки по правке 08.11: каталог (страницы пока нет — P-12) и запись на тест инструментов -->
  <div class="btns s5-btns">
    <a class="btn btn--line" href="#" data-pending="P-12">Смотреть каталог</a>
    <button type="button" class="btn btn--blue" data-open="visit">Записаться на тест инструментов</button>
  </div>
</section>

<!-- 06 · Почему доверяют -->
<section class="sec s6 bg-white" aria-labelledby="h-s6" data-stats-wrap>
  <div class="sec-head">
    <div class="mono">E · 6/10</div>
    <h2 id="h-s6" class="h2 h2--long s6-h"><span class="s6-accent">Мастера,</span> которые стоят <span class="s6-indent">у истоков культуры<br>ханга в России</span></h2>
  </div>
  <div class="s6-grid">
    <div class="s6-num" aria-hidden="true"><div class="s6-col" data-stat-col>
      {D.stats.map(s => <span>{fmtN(s.n)}{s.suf}</span>)}
    </div></div>
    <div class="stack s6-side">
      <p class="s6-label" data-stat-label aria-live="polite">
        {D.stats.map((s, i) => <span hidden={i > 0}><span class="sr">{fmtN(s.n)}{s.suf} </span>{s.label}</span>)}
      </p>
      <div class="s6-dots">
        <div class="s6-dots-in" data-stat-dots role="group" aria-label="Цифры">
          {D.stats.map((s, i) => <button type="button" class="s6-dot" aria-label={`Цифра ${i + 1}: ${fmtN(s.n)}${s.suf}`}></button>)}
        </div>
        <span class="mono s6-count" data-stat-count>01 / {pad(D.stats.length)}</span>
      </div>
    </div>
  </div>
  <span class="mono s6-note" data-pending="P-04">Цифры – уточнить</span>
</section>

<!-- 07 · Кто учит -->
<section class="sec s7 bg-sky" id="teach" aria-labelledby="h-s7">
  <div class="head-row">
    <div class="sec-head">
      <div class="mono">F · 7/10</div>
      <h2 id="h-s7" class="h-display">Кто учит</h2>
    </div>
    <p class="small s7-note">Научиться можно с нуля, в любом возрасте и без музыкального опыта. Главное – преподаватель, который слышит вас</p>
  </div>
  <div class="tcar bleed" data-tcar aria-roledescription="карусель" aria-label="Преподаватели">
    {TEACH.map((p, i) => (
      <button type="button" class="tcard" data-i={i} aria-label={p.name}>
        {p.img
          ? <img src={u(p.img)} srcset={p.imgSmall ? `${u(p.imgSmall)} 480w, ${u(p.img)} 960w` : undefined} sizes="(min-width:1000px) 26vw, 62vw" alt={`Портрет: ${p.name}`} width={p.imgWidth || 720} height={p.imgHeight || 960} loading="lazy">
          : <span class="tcard-ini" aria-hidden="true" data-pending-link="P-13">{initials(p.name)}</span>}
        <span class="tcard-shade"></span>
        <span class="tcard-cap"><span class="tcard-name">{p.name}</span><span class="tcard-role">{p.roleShort}</span></span>
      </button>
    ))}
  </div>
  <div class="tnav">
    <button type="button" class="arr" data-t-prev aria-label="Предыдущий преподаватель">←</button>
    <span class="mono tcount" data-t-count aria-live="polite">01 / {pad(TEACH.length)}</span>
    <button type="button" class="arr arr--ink" data-t-next aria-label="Следующий преподаватель">→</button>
  </div>
  <div class="btns">
    <button type="button" class="btn btn--blue btn--full-n" data-open="trial">Записаться на пробное занятие</button>
    <a class="btn btn--line btn--wrap" href={u('cources#teachers')}>Все преподаватели и форматы →</a>
  </div>
</section>

<!-- 08 · Как делают ханг -->
<section class="s8 bg-dark on-dark" id="making" aria-labelledby="h-s8">
  <!-- переделано 14.11: новый текст, справа вертикальное видео из мастерской (беззвучная петля);
       кнопка открывает полное видео со звуком в окне -->
  <div class="sec s8n">
    <div class="s8n-text">
      <span class="mono">G · 8/10</span>
      <p class="s8n-kick">Ханг — это</p>
      <h2 id="h-s8" class="h-display s8n-h"><span>Сотни этапов</span> <span><span class="cap cap--hero s8n-cap">точной работы</span></span> <span class="s8-hl">с металлом</span></h2>
      <div class="s8n-copy">
      <p class="s8n-body s8n-lead">Изготовление музыкального инструмента требует качественной стали, точной формовки звуковых полей и кропотливой настройки каждой ноты.</p>
      <p class="s8n-acc">Каждый инструмент проходит <em>несколько циклов ручной настройки</em></p>
      <p class="s8n-body s8n-b2">U-GENE — это годы практики, накопленный опыт и любовь к своему делу.</p>
      <p class="s8n-body s8n-sup">Мы создаём инструменты, соответствующие высоким профессиональным стандартам мирового хэндпан-сообщества.</p>
      </div>
      <!-- кнопки по правке 14.11: подробнее — посадочная «Инструменты», каталог, подбор инструмента -->
      <div class="btns s8n-btns">
        <a class="btn btn--milk" href={u('instruments')}>Подробнее</a>
        <a class="btn btn--line-d" href={u('catalog')}>Каталог</a>
        <button type="button" class="btn btn--line-d" data-open="help">Подбор инструмента</button>
      </div>
    </div>
    <div class="s8n-media">
      <video class="s8n-video" data-video-open title="Смотреть со звуком" muted loop playsinline preload="none" poster={u('video/making-loop.jpg')} width="720" height="1280" data-loop-src={u('video/making-loop.mp4')} aria-label="Мастер настраивает ханг в мастерской"></video>
      <button type="button" class="s8n-watch glass-d" data-video-open><span class="s8-vplay" aria-hidden="true"><svg viewBox="0 0 22 22" width="12" height="12"><path d="M6 3 L19 11 L6 19 Z" fill="currentColor"/></svg></span>Полное видео из мастерской</button>
    </div>
  </div>
</section>

<!-- 09 · Ханг объединяет -->
<section class="sec s9 bg-white" id="community" aria-labelledby="h-s9">
  <!-- раскладка по макету 12.11: заголовок с акцентом и кнопкой, две колонки текста, ниже два фото в ряд -->
  <div class="s9-top">
    <div class="stack s9-head">
      <h2 id="h-s9" class="h2 s9-h">Ханг объединяет</h2>
      <p class="s9-acc">Ты приходишь за звуком. <span class="s9-acc-2">А&nbsp;находишь своё окружение</span></p>
      {D.communityUrl
        ? <a class="btn btn--blue s9-btn" href={D.communityUrl}>Присоединиться к комьюнити →</a>
        : <button type="button" class="btn btn--blue s9-btn" data-open="community">Присоединиться к комьюнити →</button>}
    </div>
    <div class="stack s9-col">
      <p class="s9-intro">Круг, где ты становишься частью культуры.</p>
      <p>Хэндпан-сообщества — одни из самых гостеприимных в мире музыки.</p>
      <p>Здесь ценится не статус, опыт или уровень мастерства, а сам интерес к звуку. На одном джеме могут встретиться виртуоз, человек с первым хангом и тот, кто пришёл просто послушать.</p>
    </div>
    <div class="stack s9-col">
      <p>Это культура, в которой знания передают друг другу, музыкой делятся, а знакомства легко превращаются в дружбу и совместные проекты.</p>
      <p>Джемы, концерты, выезды, фестивали, встречи с мастерами и музыкантами. Доступ к самым актуальным событиям и знаниям. Люди, с которыми хочется продолжать играть уже за пределами музыки.</p>
    </div>
  </div>
  <!-- лента фото комьюнити (правка 14.11): медленно и непрерывно едет сама; второй проход — копия для бесшовной петли -->
  <div class="s9-reel" aria-label="Фото комьюнити">
    <div class="s9-track">
      {[0, 1].map(pass => COMM.map(p => (
        <img src={u(p.src)} alt={pass ? '' : p.alt} aria-hidden={pass ? 'true' : undefined} width={p.w} height={p.h} decoding="async">
      )))}
    </div>
  </div>
</section>

<!-- 10 · Финал и контакты -->
<section class="sec s10 bg-sky" id="final" aria-labelledby="h-s10">
  <div class="glow s10-glow" aria-hidden="true"></div>
  <BrandLines class="brand-lines--contact" />
  <div class="stack s10-head">
    <div class="mono row-sb"><span>Пробное занятие</span><span>C · 10/10</span></div>
    <h2 id="h-s10" class="h-hero s10-h">
      <span class="s10-l1"><span>Найди</span> <span class="cap cap--blue cap--wine">свой</span> <span>звук</span></span>
      <span class="s10-l2">за 45 минут</span>
    </h2>
  </div>
  <BranchContacts />
  <footer class="foot">
    <Logo class="foot-logo" />
    <div class="foot-links"><a class="lnk" href="#" data-pending="P-10">Политика конфиденциальности</a><a class="lnk" href="#" data-pending="P-10">Договор оферты</a></div>
  </footer>
</section>

</main>

<!-- липкая панель -->
<div class="bar" data-sticky="560">
  <div class="glass-l bar-in">
    <div class="bar-l">
      <button type="button" class="play bar-play" data-play aria-label="Послушать, как звучит ханг"></button>
      <div class="stack bar-meta">
        <div class="bar-row"><span class="bar-t">Как звучит ханг</span><span class="bar-time" data-time>0:00</span></div>
        <div class="bar-prog"><div data-progress></div></div>
      </div>
    </div>
    <button type="button" class="btn btn--48 btn--blue" data-open="trial">Записаться</button>
  </div>
</div>

<!-- видео из мастерской: грузится только при открытии -->
<dialog class="vmodal" data-video aria-label="Видео из мастерской: настройка ханга">
  <button type="button" class="x vmodal-x" data-video-close aria-label="Закрыть видео">×</button>
  <video controls playsinline preload="none" poster={u('video/making-poster.jpg')} width="720" height="1280" data-src={u('video/making.mp4')} data-poster={u('video/making-poster.jpg')} data-src-wide={u('video/making-full.mp4')} data-poster-wide={u('video/making-full.jpg')}></video>
</dialog>

<!-- форма записи: модалка / bottom sheet -->
<div class="sheet" data-sheet hidden>
  <div class="sheet-card" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <div class="sheet-head">
      <div class="sheet-title" id="sheet-title" data-sheet-title></div>
      <button type="button" class="x" data-close aria-label="Закрыть">×</button>
    </div>
    <p class="small body--2" data-sheet-help hidden>Можно начать с обучения, взять инструмент в аренду или сразу выбрать свой. Оставьте контакты – подскажем, с чего начать именно вам</p>
    <LeadForm id="m" />
    <p class="thanks" data-thanks hidden tabindex="-1">Спасибо! Перезвоним в течение дня</p>
  </div>
</div>
<!-- тест «Поможем определиться» в окне; quiz.js грузится по кнопке, без JS ссылка ведёт на /test -->
<div class="sheet qsheet" data-quiz-modal hidden>
  <div class="sheet-card qsheet-card" role="dialog" aria-modal="true" aria-labelledby="qm-title">
    <div class="sheet-head">
      <div class="sheet-title" id="qm-title">С чего вам начать</div>
      <button type="button" class="x" data-quiz-close aria-label="Закрыть">×</button>
    </div>
    <p class="small">{QD.intro}</p>
    <Quiz id="hq" />
  </div>
</div>
</Base>
