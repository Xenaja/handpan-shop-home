---
// «Инструменты» — посадочная о хэндпанах U-GENE (черновик на 2 экрана, 10.11). По принципу «Обучения».
// Каталог — отдельно, /catalog (SEO-MIGRATION.md, п. 87): эта страница ведёт в него и не перебивает его запрос «купить хэндпан».
// Ссылки задач ведут в каталог с фильтром ?use=… (SEO-MIGRATION.md, п. 178), canonical таких адресов — /catalog.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import MenuExtras from '../components/MenuExtras.astro';
import BrandLines from '../components/BrandLines.astro';
import LeadForm from '../components/LeadForm.astro';
import BranchContacts from '../components/BranchContacts.astro';
import D from '../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const home = `${base}/`;
// первый экран — текст ANN 13.11 (правка №62): счётчик «Более 2000» и «40+ в студии»
const MADE = 2000, IN_STUDIO = 40;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://handpanshop.pro/' },
      { '@type': 'ListItem', position: 2, name: 'Инструменты' } ] }
  ]
};
---
<Base
  title="Хэндпаны ручной работы — собственное производство · U-GENE"
  description="Хэндпаны (ханги) собственного производства с 2019 года: 5 видов стали, гарантия 5 лет. Послушайте 40+ инструментов в студии в Москве и Санкт-Петербурге."
  ogTitle="Хэндпаны ручной работы U-GENE"
  ogDescription="Собственное производство с 2019 года. Послушайте 40+ инструментов в студии."
  path="/instruments" ogImage="img/hero-scene-d.webp" theme="#0A1020"
  styles={['common.css', 'learn.css', 'inst.css', 'making.css', 'mobile.css']} scripts={['common.js', 'inst.js', 'making.js']} jsonld={jsonld}>

<!-- 01 · Хэндпаны ручной работы -->
<header class="e1 i1 on-dark" id="top">
  <div class="i1-glow" aria-hidden="true"></div>
  <!-- ханги по очереди укатываются и выкатываются (inst.js); без JS и при «меньше движения» виден первый -->
  <div class="i1-stage" data-roll aria-hidden="true">
    <div class="i1-float">
      <img class="i1-hang is-on" src={u('img/handpan-bronze-cutout.webp')} alt="" width="880" height="880" fetchpriority="high">
      <img class="i1-hang" src={u('img/handpan-iridescent-cutout.webp')} alt="" width="880" height="880" loading="lazy">
      <img class="i1-hang" src={u('img/handpan-fsharp-cutout.webp')} alt="" width="880" height="880" loading="lazy">
    </div>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <div class="hdr">
    <Logo class="pill glass-d logo" href={home} />
    <nav class="pill glass-d nav nav--edu hdr-d" aria-label="Основное меню">
      <a class="lnk" href={home}>На главную</a><a class="lnk" href={u('cources')}>Обучение</a><span class="nav-on" aria-current="page">Инструменты</span><a class="lnk" href="#contacts">Контакты</a>
    </nav>
    <div class="pill glass-d city e1-city hdr-d" role="group" aria-label="Город">
      <button type="button" data-city="msk" aria-pressed="true">Москва</button><a href={D.spbSite} target="_blank" rel="noopener">Санкт-Петербург</a>
    </div>
    <div class="hdr-n"><span class="burger-slot" aria-hidden="true"></span></div>
  </div>

  <div class="e1-body">
    <div class="stack e1-top">
      <!-- один H1: призыв + подзаголовок с ключевыми словами «хэндпаны ручной работы» (как на главной) -->
      <h1 class="i1-h1">
        <span class="h-hero e1-h1">
          <span>Выбери</span>
          <span class="cap cap--hero e1-cap i1-cap">свой</span>
          <span>инструмент</span>
        </span>
        <span class="i1-lead">Хэндпаны ручной работы от U-GENE. Собственное производство с 2019 года.</span>
      </h1>
      <div class="stack e1-text">
        <ul class="i1-points">
          <li>Каждый инструмент настроен вручную</li>
          <li>Проверен мастерами, музыкантами и основателем</li>
          <li>Строй, сталь и ноты — под вашу задачу</li>
        </ul>
        <div class="btns e1-btns">
          <!-- «Смотреть каталог» снят (правка 24.11): каталога на новом сайте пока нет, страница — первый экран, заявка и контакты -->
          <!-- «Подобрать» сразу выбирает «Подбор и покупка инструмента», а не «Задать вопрос» (скрин формы 24.11) -->
          <button type="button" class="btn btn--52 btn--blue" data-open="buy">Подобрать свой хэндпан</button>
          <button type="button" class="btn btn--52 btn--line-d" data-open="help">Задать вопрос</button>
        </div>
      </div>
    </div>
    <ul class="i1-facts i1-facts--2" aria-label="Коротко о производстве">
      <li><b><span class="i1-more">более</span> <span data-count={MADE}>{MADE.toLocaleString('ru-RU')}</span></b><span>инструментов сделано для вас</span></li>
      <li><b>{IN_STUDIO}+</b><span>инструментов для знакомства и тестирования в студии</span></li>
    </ul>
  </div>
</header>

<nav class="menu menu--sand" id="menu" hidden aria-label="Меню">
  <div class="menu-top">
    <Logo style="padding:0" href={home} />
    <button type="button" class="x" data-menu-close aria-label="Закрыть меню">×</button>
  </div>
  <div class="menu-links">
    <a href={home}>На главную</a><a href={u('cources')}>Обучение</a><span class="menu-on" aria-current="page">Инструменты</span><a href="#contacts">Контакты</a>
  </div>
  <div class="btns" role="group" aria-label="Город">
    <button type="button" class="chip" data-city="msk" aria-pressed="true">Москва</button><a class="chip" href={D.spbSite} target="_blank" rel="noopener">Санкт-Петербург ↗</a>
  </div>
  <MenuExtras cta="visit" ctaLabel="Записаться в студию" />
</nav>
<button type="button" class="burger" aria-expanded="false" aria-controls="menu" aria-label="Меню"><span></span><span></span></button>

<main id="main">

<!-- 02 · Как делают ханг — перенесён с главной (правка 25.11) -->
<section class="s8 bg-dark on-dark" id="making" aria-labelledby="h-s8">
  <!-- переделано 14.11: новый текст, справа вертикальное видео из мастерской (беззвучная петля);
       кнопка открывает полное видео со звуком в окне -->
  <div class="sec s8n">
    <div class="s8n-text">
      <span class="mono">02</span>
      <p class="s8n-kick">Ханг — это</p>
      <h2 id="h-s8" class="h-display s8n-h"><span>Сотни этапов</span> <span><span class="cap cap--hero s8n-cap">точной работы</span></span> <span class="s8-hl">с металлом</span></h2>
      <div class="s8n-copy">
      <p class="s8n-body s8n-lead">Изготовление музыкального инструмента требует качественной стали, точной формовки звуковых полей и кропотливой настройки каждой ноты.</p>
      <p class="s8n-acc">Каждый инструмент проходит <em>несколько циклов ручной настройки</em></p>
      <p class="s8n-body s8n-b2">U-GENE — это годы практики, накопленный опыт и любовь к своему делу.</p>
      <p class="s8n-body s8n-sup">Мы создаём инструменты, соответствующие высоким профессиональным стандартам мирового хэндпан-сообщества.</p>
      </div>
    </div>
    <div class="s8n-media">
      <video class="s8n-video" data-video-open title="Смотреть со звуком" muted loop playsinline preload="none" poster={u('video/making-loop.jpg')} width="720" height="1280" data-loop-src={u('video/making-loop.mp4')} aria-label="Мастер настраивает ханг в мастерской"></video>
      <button type="button" class="s8n-watch glass-d" data-video-open><span class="s8-vplay" aria-hidden="true"><svg viewBox="0 0 22 22" width="12" height="12"><path d="M6 3 L19 11 L6 19 Z" fill="currentColor"/></svg></span>Полное видео из мастерской</button>
    </div>
  </div>
</section>

<!-- 02 · «Какой ханг выбрать» со ссылками в каталог снят до переезда каталога (правка 24.11); вернуть — коммит до правок 24.11 -->

<!-- финал: контакты студий -->
<section class="sec bg-dark on-dark e11" id="final" aria-labelledby="h-i3">
  <div class="glow e11-glow" aria-hidden="true"></div>
  <BrandLines class="brand-lines--learn" />
  <div class="e11-grid">
    <div class="stack e11-l">
      <span class="mono">Студии в Москве и Санкт-Петербурге</span>
      <h2 id="h-i3" class="h-hero e11-h">
        <span class="e11-l1"><span>Услышь</span> <span class="cap cap--hero e11-cap">свой</span> <span>ханг</span></span>
        <span>вживую</span>
      </h2>
    </div>
  </div>
  <BranchContacts />
  <footer class="efoot">
    <span>© Handpan Shop · Москва · СПб</span>
    <nav class="efoot-nav" aria-label="Документы и разделы"><a class="lnk" href={u('politikaconfidencialnosti')}>Политика конфиденциальности</a><a class="lnk" href={home}>На главную →</a></nav>
  </footer>
</section>

</main>

<dialog class="vmodal" data-video aria-label="Видео из мастерской: настройка ханга">
  <button type="button" class="x vmodal-x" data-video-close aria-label="Закрыть видео">×</button>
  <video controls playsinline preload="none" poster={u('video/making-poster.jpg')} width="720" height="1280" data-src={u('video/making.mp4')} data-poster={u('video/making-poster.jpg')} data-src-wide={u('video/making-full.mp4')} data-poster-wide={u('video/making-full.jpg')}></video>
</dialog>

<!-- липкая панель -->
<div class="bar bar--edu" data-sticky="520">
  <div class="glass-l bar-in">
    <div class="bar-txt"><span class="bar-name">Тест инструментов</span><span class="mono">40+ в студии · без обязательств</span></div>
    <button type="button" class="btn btn--48 btn--blue" data-open="visit">Записаться</button>
  </div>
</div>

<!-- форма заявки: модалка / bottom sheet -->
<div class="sheet" data-sheet hidden>
  <div class="sheet-card" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <div class="sheet-head">
      <div class="sheet-title" id="sheet-title" data-sheet-title>Визит в студию</div>
      <button type="button" class="x" data-close aria-label="Закрыть">×</button>
    </div>
    <p class="small body--2" data-sheet-help hidden>Расскажите, для чего нужен инструмент, — подскажем строй, сталь и количество нот</p>
    <LeadForm id="m" note="Перезвоним, ответим на вопросы и подберём время" />
    <div class="stack thanks-box" data-thanks hidden tabindex="-1">
      <span class="sheet-title">Спасибо!</span>
      <span>Перезвоним в течение дня</span>
      <button type="button" class="btn btn--52 btn--ink" data-close>Закрыть</button>
    </div>
  </div>
</div>
</Base>
